// Slint UI for arcthumb-config.exe.
//
// Exported components:
//   * MainWindow    — tabbed settings dialog with File / Help menu bar.
//   * AboutDialog   — shows ArcThumb version up top and the Slint
//                     attribution widget below (required by the
//                     Slint Royalty-Free License 2.0). Reached via
//                     Help → About.
//   * UpdateDialog  — "new version available" prompt with a
//                     "Skip this version" checkbox. Replaces the old
//                     three-button MessageBox.
//   * DonationDialog — "thanks for updating" prompt with a
//                     "Don't show again" checkbox.
//
// All user-visible strings come from the Rust side via `in` properties
// rather than `@tr("...")`. A future refactor may switch to gettext
// once the build toolchain is wired up.

import {
    AboutSlint,
    Button,
    CheckBox,
    ComboBox,
    GroupBox,
    HorizontalBox,
    ScrollView,
    TabWidget,
    VerticalBox,
} from "std-widgets.slint";

// One row in the per-extension toggle list. Owned by the Rust side
// (`extension_model::ExtensionModel`) and handed to `MainWindow`
// via `set_extensions`. Names come from `arcthumb::registry::EXTENSIONS`
// so the GUI list always matches what the registry layer recognises.
export struct ExtensionEntry {
    name: string,
    enabled: bool,
}

// Body of one tab: a scrollable column that keeps its children at
// their natural height and leaves any spare room below them.
component TabPage inherits ScrollView {
    VerticalLayout {
        padding: 10px;
        spacing: 6px;
        @children
        // Soak up extra height so the widgets above don't stretch
        // when the window is resized taller.
        Rectangle { vertical-stretch: 1; }
    }
}

// Note under settings whose effect is baked into cached thumbnails.
// With tabs the Regenerate button is no longer next to them, so the
// connection has to be spelled out where the setting is.
component RegenHint inherits Text {
    vertical-stretch: 0;
    wrap: word-wrap;
    opacity: 0.7;
}

export component MainWindow inherits Window {
    title: root.window_title;
    icon: @image-url("../assets/icon.png");
    preferred-width: 520px;
    // Sized for the tallest tab (Files). The TabWidget gives every tab
    // the same area, so switching tabs never resizes the window.
    preferred-height: 400px;
    min-width: 500px;
    min-height: 300px;

    // ---- Localized labels (set from Rust at startup) -------------
    in property <string> window_title;
    in property <string> menu_file;
    in property <string> menu_file_exit;
    in property <string> menu_help;
    in property <string> menu_help_check_updates;
    in property <string> menu_help_donate;
    in property <string> menu_help_about;
    in property <string> tab_files;
    in property <string> tab_thumbnail;
    in property <string> tab_display;
    in property <string> tab_preview;
    in property <string> group_extensions;
    in property <string> group_image_exts;
    in property <string> group_sort;
    in property <string> sort_natural_label;
    in property <string> sort_alpha_label;
    in property <string> group_cover;
    in property <string> cover_prefer_label;
    in property <string> cover_only_label;
    in property <string> cover_ignore_label;
    in property <string> group_overlay;
    in property <string> regen_hint;
    in property <string> enable_preview_label;
    in property <string> overlay_border_label;
    in property <string> overlay_label_label;
    in property <string> btn_ok;
    in property <string> btn_cancel;
    in property <string> btn_apply;
    in property <string> btn_regenerate;

    // ---- Two-way bindable state ---------------------------------
    // The per-extension toggle list. Driven from Rust via a
    // `VecModel<ExtensionEntry>` so the row layout follows
    // `arcthumb::registry::EXTENSIONS` automatically.
    in property <[ExtensionEntry]> extensions;
    // Image formats eligible as thumbnail sources inside archives.
    // Parallel to `arcthumb::settings::SUPPORTED_IMAGE_EXTS`.
    in property <[ExtensionEntry]> image_extensions;
    // Sort order, as an index into the dropdown: 0 = natural, 1 =
    // alphabetical. Mapped to `SortOrder` on the Rust side. Kept as an
    // int (not a bool) so the ComboBox can two-way bind to it directly.
    in-out property <int> sort_index;
    // Cover-name handling, as an index into the dropdown:
    // 0 = prefer, 1 = only, 2 = ignore. Mapped to `CoverMode` on the
    // Rust side (`state::cover_mode_{to,from}_index`).
    in-out property <int> cover_mode;
    in-out property <bool> enable_preview;
    in-out property <bool> overlay_border;
    in-out property <bool> overlay_label;

    // ---- Callbacks ----------------------------------------------
    callback ok_clicked();
    callback cancel_clicked();
    callback apply_clicked();
    callback regenerate_clicked();
    callback about_clicked();
    callback donate_clicked();
    callback check_updates_clicked();
    callback exit_clicked();
    // User flipped the checkbox at row `index`. Slint forwards a
    // notification only — the Rust side mutates the underlying
    // `VecModel` and Slint re-reads the row.
    callback toggle_extension(int);
    // Same contract for the image-format toggle list.
    callback toggle_image_extension(int);

    MenuBar {
        Menu {
            title: root.menu_file;
            MenuItem {
                title: root.menu_file_exit;
                activated => { root.exit_clicked(); }
            }
        }
        Menu {
            title: root.menu_help;
            MenuItem {
                title: root.menu_help_check_updates;
                activated => { root.check_updates_clicked(); }
            }
            MenuItem {
                title: root.menu_help_donate;
                activated => { root.donate_clicked(); }
            }
            MenuItem {
                title: root.menu_help_about;
                activated => { root.about_clicked(); }
            }
        }
    }

    // Layout note:
    //
    // The settings are split into tabs by when you reach for them, not
    // by feature. The footer button row (OK / Cancel / Apply /
    // Regenerate) sits outside the TabWidget because it acts on every
    // tab at once; inside a tab it would read as "apply this tab only".
    //
    // Each tab body is a `TabPage`, which wraps its content in a
    // `ScrollView`. At the default size nothing scrolls. If the user
    // shrinks the window below what a tab needs, that tab scrolls and
    // the footer stays reachable — that's why `min-height` is smaller
    // than `preferred-height`.
    VerticalBox {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 8px;
        padding-bottom: 10px;
        spacing: 6px;

        TabWidget {
            vertical-stretch: 1;

            Tab {
                title: root.tab_files;
                TabPage {
                    GroupBox {
                        vertical-stretch: 0;
                        title: root.group_extensions;
                        // 6 columns wide, row-major. We compute the row/col
                        // from the iteration index `i` so the layout follows
                        // `arcthumb::registry::EXTENSIONS` order automatically.
                        // `Math.floor` and `Math.mod` are needed because Slint
                        // returns a float from `int / int`.
                        GridLayout {
                            spacing: 8px;
                            for entry[i] in root.extensions: CheckBox {
                                row: Math.floor(i / 6);
                                col: Math.mod(i, 6);
                                vertical-stretch: 0;
                                text: entry.name;
                                checked: entry.enabled;
                                toggled => {
                                    root.toggle_extension(i);
                                }
                            }
                        }
                    }

                    GroupBox {
                        vertical-stretch: 0;
                        title: root.group_image_exts;
                        GridLayout {
                            spacing: 8px;
                            for entry[i] in root.image_extensions: CheckBox {
                                row: Math.floor(i / 6);
                                col: Math.mod(i, 6);
                                vertical-stretch: 0;
                                text: entry.name;
                                checked: entry.enabled;
                                toggled => {
                                    root.toggle_image_extension(i);
                                }
                            }
                        }
                    }
                }
            }

            Tab {
                title: root.tab_thumbnail;
                TabPage {
                    GroupBox {
                        vertical-stretch: 0;
                        title: root.group_sort;
                        ComboBox {
                            vertical-stretch: 0;
                            model: [root.sort_natural_label, root.sort_alpha_label];
                            // Two-way (`<=>`) is required, not a one-way binding:
                            // the ComboBox writes current-index internally at
                            // init, which severs a one-way binding and leaves the
                            // dropdown stuck on the first item after load.
                            current-index <=> root.sort_index;
                        }
                    }

                    GroupBox {
                        vertical-stretch: 0;
                        title: root.group_cover;
                        ComboBox {
                            vertical-stretch: 0;
                            model: [
                                root.cover_prefer_label,
                                root.cover_only_label,
                                root.cover_ignore_label,
                            ];
                            // Two-way (`<=>`) is required — see the sort
                            // ComboBox above for why a one-way binding breaks.
                            current-index <=> root.cover_mode;
                        }
                    }

                    RegenHint { text: root.regen_hint; }
                }
            }

            Tab {
                title: root.tab_display;
                TabPage {
                    GroupBox {
                        vertical-stretch: 0;
                        title: root.group_overlay;
                        VerticalLayout {
                            spacing: 6px;
                            CheckBox {
                                vertical-stretch: 0;
                                text: root.overlay_border_label;
                                checked <=> root.overlay_border;
                            }
                            CheckBox {
                                vertical-stretch: 0;
                                text: root.overlay_label_label;
                                checked <=> root.overlay_label;
                            }
                        }
                    }

                    RegenHint { text: root.regen_hint; }
                }
            }

            Tab {
                title: root.tab_preview;
                TabPage {
                    CheckBox {
                        vertical-stretch: 0;
                        text: root.enable_preview_label;
                        checked <=> root.enable_preview;
                    }
                }
            }
        }

        HorizontalBox {
            vertical-stretch: 0;
            spacing: 6px;
            Button {
                text: root.btn_regenerate;
                clicked => { root.regenerate_clicked(); }
            }
            Rectangle { horizontal-stretch: 1; }
            Button {
                text: root.btn_ok;
                primary: true;
                clicked => { root.ok_clicked(); }
            }
            Button {
                text: root.btn_cancel;
                clicked => { root.cancel_clicked(); }
            }
            Button {
                text: root.btn_apply;
                clicked => { root.apply_clicked(); }
            }
        }
    }
}

export component AboutDialog inherits Window {
    title: root.dialog_title;
    icon: @image-url("../assets/icon.png");
    preferred-width: 460px;
    preferred-height: 460px;

    in property <string> dialog_title;
    in property <string> version_text;
    in property <string> body_text;
    in property <string> btn_close;

    callback close_clicked();

    VerticalBox {
        padding: 18px;
        spacing: 14px;

        Text {
            text: root.version_text;
            font-size: 18px;
            font-weight: 700;
            horizontal-alignment: center;
        }

        Text {
            text: root.body_text;
            wrap: word-wrap;
            horizontal-alignment: center;
        }

        AboutSlint { }

        Rectangle { vertical-stretch: 1; }

        HorizontalBox {
            Rectangle { horizontal-stretch: 1; }
            Button {
                text: root.btn_close;
                clicked => { root.close_clicked(); }
            }
            Rectangle { horizontal-stretch: 1; }
        }
    }
}

export component UpdateDialog inherits Window {
    title: root.dialog_title;
    icon: @image-url("../assets/icon.png");
    preferred-width: 440px;
    preferred-height: 220px;

    in property <string> dialog_title;
    in property <string> message_text;
    in property <string> skip_checkbox_label;
    in property <string> btn_open;
    in property <string> btn_later;

    in-out property <bool> skip_checked: false;

    callback open_clicked();
    callback later_clicked();

    VerticalBox {
        padding: 18px;
        spacing: 14px;

        Text {
            text: root.message_text;
            wrap: word-wrap;
        }

        CheckBox {
            text: root.skip_checkbox_label;
            checked <=> root.skip_checked;
        }

        Rectangle { vertical-stretch: 1; }

        HorizontalBox {
            spacing: 6px;
            Rectangle { horizontal-stretch: 1; }
            Button {
                text: root.btn_open;
                primary: true;
                clicked => { root.open_clicked(); }
            }
            Button {
                text: root.btn_later;
                clicked => { root.later_clicked(); }
            }
        }
    }
}

export component DonationDialog inherits Window {
    title: root.dialog_title;
    icon: @image-url("../assets/icon.png");
    preferred-width: 440px;
    preferred-height: 220px;

    in property <string> dialog_title;
    in property <string> message_text;
    in property <string> dont_show_label;
    in property <string> btn_support;
    in property <string> btn_later;

    in-out property <bool> dont_show_checked: false;

    callback support_clicked();
    callback later_clicked();

    VerticalBox {
        padding: 18px;
        spacing: 14px;

        Text {
            text: root.message_text;
            wrap: word-wrap;
        }

        CheckBox {
            text: root.dont_show_label;
            checked <=> root.dont_show_checked;
        }

        Rectangle { vertical-stretch: 1; }

        HorizontalBox {
            spacing: 6px;
            Rectangle { horizontal-stretch: 1; }
            Button {
                text: root.btn_support;
                primary: true;
                clicked => { root.support_clicked(); }
            }
            Button {
                text: root.btn_later;
                clicked => { root.later_clicked(); }
            }
        }
    }
}

// Preview-only wrapper. The production `MainWindow` receives every
// `in property <string>` from Rust at startup; VS Code's Slint preview
// and `slint-viewer` have no Rust side, so they render those properties
// as empty strings and the toggle lists as empty arrays. This component
// inherits `MainWindow` and assigns plausible Japanese defaults so the
// preview shows a realistic layout. Not used by the binary — Rust still
// instantiates `MainWindow` directly, and these defaults are overridden
// the moment `set_*` is called at startup.
export component MainWindowPreview inherits MainWindow {
    window_title: "ArcThumb 設定";
    menu_file: "ファイル";
    menu_file_exit: "終了";
    menu_help: "ヘルプ";
    menu_help_check_updates: "更新を確認";
    menu_help_donate: "ArcThumb を支援する";
    menu_help_about: "ArcThumb について";
    tab_files: "対象ファイル";
    tab_thumbnail: "サムネイル";
    tab_display: "表示";
    tab_preview: "プレビュー";
    group_extensions: "有効にする拡張子";
    group_image_exts: "サムネイルに使う画像形式 (アーカイブ内)";
    group_sort: "並び順";
    sort_natural_label: "自然順 (page2 < page10)";
    sort_alpha_label: "アルファベット順";
    group_cover: "カバー画像 (cover / folder / thumb / thumbnail / front)";
    cover_prefer_label: "カバーを優先（無ければ先頭ページ）";
    cover_only_label: "カバーがあるときだけ表示（無ければ通常アイコン）";
    cover_ignore_label: "常に先頭ページを使う";
    group_overlay: "識別オーバーレイ";
    regen_hint: "作成済みのサムネイルに反映するには「サムネイルを再生成」を実行してください。";
    enable_preview_label: "プレビュー ウィンドウを有効にする (Alt+P)";
    overlay_border_label: "アーカイブを色付きの枠線で示す";
    overlay_label_label: "アーカイブにフォーマットラベルを表示 (CBZ, EPUB, ...)";
    btn_ok: "OK";
    btn_cancel: "キャンセル";
    btn_apply: "適用";
    btn_regenerate: "サムネイルを再生成";

    // Dummy toggle rows so the grids actually render. Lengths roughly
    // match the real `registry::EXTENSIONS` and `SUPPORTED_IMAGE_EXTS`
    // so the preview shows the same number of rows as production.
    extensions: [
        { name: ".zip",  enabled: true  },
        { name: ".cbz",  enabled: true  },
        { name: ".rar",  enabled: true  },
        { name: ".cbr",  enabled: false },
        { name: ".7z",   enabled: true  },
        { name: ".cb7",  enabled: false },
        { name: ".tar",  enabled: false },
        { name: ".epub", enabled: true  },
        { name: ".fb2",  enabled: false },
        { name: ".mobi", enabled: false },
        { name: ".azw",  enabled: false },
        { name: ".azw3", enabled: false },
    ];
    image_extensions: [
        { name: ".jpg",  enabled: true  },
        { name: ".jpeg", enabled: true  },
        { name: ".png",  enabled: true  },
        { name: ".gif",  enabled: true  },
        { name: ".bmp",  enabled: true  },
        { name: ".tiff", enabled: true  },
        { name: ".tif",  enabled: true  },
        { name: ".webp", enabled: true  },
        { name: ".ico",  enabled: true  },
    ];
}
