// Slint UI for arcthumb-config.exe.
//
// Exported components:
//   * MainWindow    — tabbed settings dialog with File / Help menu bar.
//   * AboutDialog   — shows ArcThumb version up top and the Slint
//                     attribution widget below (required by the
//                     Slint Royalty-Free License 2.0). Reached via
//                     Help → About.
//   * UpdateDialog  — "new version available" prompt with a
//                     "Skip this version" checkbox. Replaces the old
//                     three-button MessageBox.
//   * DonationDialog — "thanks for updating" prompt with a
//                     "Don't show again" checkbox.
//   * Texts         — global holding the strings the Rust side shows
//                     outside Slint (native MessageBox prompts) plus
//                     the locale-specific support URL.
//
// Translations
//
// Every user-visible string is written in English inside `@tr("...")`.
// `build.rs` bundles the `.po` files under `lang/<tag>/LC_MESSAGES/`
// into the binary, and `locale.rs` picks the language at startup with
// `slint::select_bundled_translation`. To add a language, see the
// "Translating" section of README.md; no Rust changes are needed
// beyond the native-name table in `locale.rs`.
//
// The `.pot` template in `lang/` is regenerated from this file with
// `slint-tr-extractor` (see README.md), so keep strings in `@tr()`
// rather than building them from fragments.

import {
    AboutSlint,
    Button,
    CheckBox,
    ComboBox,
    GroupBox,
    HorizontalBox,
    ScrollView,
    TabWidget,
    VerticalBox,
} from "std-widgets.slint";

// One row in the per-extension toggle list. Owned by the Rust side
// (`extension_model::ExtensionModel`) and handed to `MainWindow`
// via `set_extensions`. Names come from `arcthumb::registry::EXTENSIONS`
// so the GUI list always matches what the registry layer recognises.
export struct ExtensionEntry {
    name: string,
    enabled: bool,
}

// Strings the Rust side needs as plain text: titles and bodies of the
// native MessageBox prompts (which are not Slint widgets), the label
// for the "Automatic" entry of the language dropdown (the dropdown
// model is assembled in Rust because the other entries come from the
// bundled language list), and the support URL, which is translated
// so each language lands on its own page.
export global Texts {
    // Title of every MessageBox this tool shows.
    out property <string> app_title: @tr("ArcThumb");
    out property <string> language_auto: @tr("Automatic (follow Windows)");

    out property <string> regen_confirm: @tr("This will close all Explorer windows, delete the Windows thumbnail and icon caches, and restart Explorer.\n\nUse this if archive thumbnails are still missing after installing or enabling new file types, or to apply a change to the identification overlay.\n\nContinue?");
    out property <string> regen_done: @tr("Thumbnail cache cleared and Explorer restarted.\n\nNew thumbnails will be generated as you browse.");
    out property <string> regen_partial: @tr("Some cache files were locked and could not be deleted. Try closing other applications and run this again.");

    out property <string> error_save: @tr("Failed to save settings to the registry.");
    out property <string> error_register: @tr("Failed to update shell extension registration.");
    out property <string> error_elevation_declined: @tr("ArcThumb is installed for all users, so changing the enabled extensions or the preview pane needs administrator rights.\n\nThose two settings were not changed.");

    // Manual "check for updates", triggered from the Help menu.
    out property <string> update_check_title: @tr("Check for updates");
    out property <string> update_check_failed: @tr("Could not check for updates. Check your internet connection and try again.");
    pure public function update_up_to_date(version: string) -> string {
        return @tr("You're on the latest version (v{}).", version);
    }

    // The support page opened from Help → Support and from the
    // post-update prompt. This is the only donation URL baked into
    // the binary — the platform links (GitHub Sponsors, Buy Me a
    // Coffee) live on that page, so they can change without an app
    // rebuild. (The comment line right above a `@tr` is copied into
    // the .pot as a note for translators.)
    //
    // Translators: the support page in your language, or leave as is.
    out property <string> support_url: @tr("https://citrussoda.com/en/arcthumb/sponsor");
}

// Body of one tab: a scrollable column that keeps its children at
// their natural height and leaves any spare room below them.
component TabPage inherits ScrollView {
    VerticalLayout {
        padding: 10px;
        spacing: 6px;
        @children
        // Soak up extra height so the widgets above don't stretch
        // when the window is resized taller.
        Rectangle { vertical-stretch: 1; }
    }
}

// Dimmed note under a setting that does not take effect right away.
// Mostly used for settings whose effect is baked into cached
// thumbnails: with tabs the Regenerate button is no longer next to
// them, so the connection has to be spelled out where the setting is.
component RegenHint inherits Text {
    vertical-stretch: 0;
    wrap: word-wrap;
    opacity: 0.7;
}

export component MainWindow inherits Window {
    title: root.window_title;
    icon: @image-url("../assets/icon.png");
    preferred-width: 520px;
    // Sized for the tallest tab (Display). The TabWidget gives every
    // tab the same area, so switching tabs never resizes the window.
    preferred-height: 540px;
    min-width: 500px;
    min-height: 300px;

    // Exposed as a property (rather than written straight into
    // `title`) so the Rust tests can read it back and check that the
    // bundled translation actually switched.

    out property <string> window_title: @tr("ArcThumb Configuration");

    // ---- Two-way bindable state ---------------------------------
    // The per-extension toggle list. Driven from Rust via a
    // `VecModel<ExtensionEntry>` so the row layout follows
    // `arcthumb::registry::EXTENSIONS` automatically.
    in property <[ExtensionEntry]> extensions;
    // Image formats eligible as thumbnail sources inside archives.
    // Parallel to `arcthumb::settings::SUPPORTED_IMAGE_EXTS`.
    in property <[ExtensionEntry]> image_extensions;
    // Which archive extensions get the identification overlay.
    // Parallel to `arcthumb::registry::EXTENSIONS`, like `extensions`.
    in property <[ExtensionEntry]> overlay_extensions;
    // Sort order, as an index into the dropdown: 0 = natural, 1 =
    // alphabetical. Mapped to `SortOrder` on the Rust side. Kept as an
    // int (not a bool) so the ComboBox can two-way bind to it directly.
    in-out property <int> sort_index;
    // Cover-name handling, as an index into the dropdown:
    // 0 = prefer, 1 = only, 2 = ignore. Mapped to `CoverMode` on the
    // Rust side (`state::cover_mode_{to,from}_index`).
    in-out property <int> cover_mode;
    in-out property <bool> enable_preview;
    in-out property <bool> overlay_border;
    in-out property <bool> overlay_label;
    // Entries of the language dropdown: `Texts.language_auto` first,
    // then every language in `locale::LANGUAGES`, each shown in its
    // own language so it can be found from any UI language. Built on
    // the Rust side because the list depends on which `.po` files
    // were bundled at build time.
    in property <[string]> language_names;
    // UI language, as an index into `language_names`: 0 = follow
    // Windows, otherwise `locale::LANGUAGES[index - 1]`. Mapped to
    // `locale::LanguageChoice` on the Rust side.
    in-out property <int> language_index;

    // ---- Callbacks ----------------------------------------------
    callback ok_clicked();
    callback cancel_clicked();
    callback apply_clicked();
    callback regenerate_clicked();
    callback about_clicked();
    callback donate_clicked();
    callback check_updates_clicked();
    callback exit_clicked();
    // User flipped the checkbox at row `index`. Slint forwards a
    // notification only — the Rust side mutates the underlying
    // `VecModel` and Slint re-reads the row.
    callback toggle_extension(int);
    // Same contract for the image-format toggle list.
    callback toggle_image_extension(int);
    // And for the per-extension overlay list.
    callback toggle_overlay_extension(int);

    MenuBar {
        Menu {
            title: @tr("File");
            MenuItem {
                title: @tr("Exit");
                activated => { root.exit_clicked(); }
            }
        }
        Menu {
            title: @tr("Help");
            MenuItem {
                title: @tr("Check for updates");
                activated => { root.check_updates_clicked(); }
            }
            MenuItem {
                title: @tr("Support ArcThumb");
                activated => { root.donate_clicked(); }
            }
            MenuItem {
                title: @tr("About ArcThumb");
                activated => { root.about_clicked(); }
            }
        }
    }

    // Layout note:
    //
    // The settings are split into tabs by when you reach for them, not
    // by feature. The footer button row (OK / Cancel / Apply /
    // Regenerate) sits outside the TabWidget because it acts on every
    // tab at once; inside a tab it would read as "apply this tab only".
    //
    // Each tab body is a `TabPage`, which wraps its content in a
    // `ScrollView`. At the default size nothing scrolls. If the user
    // shrinks the window below what a tab needs, that tab scrolls and
    // the footer stays reachable — that's why `min-height` is smaller
    // than `preferred-height`.
    VerticalBox {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 8px;
        padding-bottom: 10px;
        spacing: 6px;

        TabWidget {
            vertical-stretch: 1;

            Tab {
                title: @tr("Files");
                TabPage {
                    GroupBox {
                        vertical-stretch: 0;
                        title: @tr("Enabled extensions");
                        // 6 columns wide, row-major. We compute the row/col
                        // from the iteration index `i` so the layout follows
                        // `arcthumb::registry::EXTENSIONS` order automatically.
                        // `Math.floor` and `Math.mod` are needed because Slint
                        // returns a float from `int / int`.
                        GridLayout {
                            spacing: 8px;
                            for entry[i] in root.extensions: CheckBox {
                                row: Math.floor(i / 6);
                                col: Math.mod(i, 6);
                                vertical-stretch: 0;
                                text: entry.name;
                                checked: entry.enabled;
                                toggled => {
                                    root.toggle_extension(i);
                                }
                            }
                        }
                    }

                    GroupBox {
                        vertical-stretch: 0;
                        title: @tr("Image formats used for thumbnails (inside archives)");
                        GridLayout {
                            spacing: 8px;
                            for entry[i] in root.image_extensions: CheckBox {
                                row: Math.floor(i / 6);
                                col: Math.mod(i, 6);
                                vertical-stretch: 0;
                                text: entry.name;
                                checked: entry.enabled;
                                toggled => {
                                    root.toggle_image_extension(i);
                                }
                            }
                        }
                    }
                }
            }

            Tab {
                title: @tr("Thumbnail");
                TabPage {
                    GroupBox {
                        vertical-stretch: 0;
                        title: @tr("Sort order");
                        ComboBox {
                            vertical-stretch: 0;
                            model: [
                                @tr("Natural (page2 < page10)"),
                                @tr("Alphabetical"),
                            ];
                            // Two-way (`<=>`) is required, not a one-way binding:
                            // the ComboBox writes current-index internally at
                            // init, which severs a one-way binding and leaves the
                            // dropdown stuck on the first item after load.
                            current-index <=> root.sort_index;
                        }
                    }

                    GroupBox {
                        vertical-stretch: 0;
                        title: @tr("Cover image (cover / folder / thumb / thumbnail / front)");
                        ComboBox {
                            vertical-stretch: 0;
                            model: [
                                @tr("Use cover if present, else first page"),
                                @tr("Cover only (no thumbnail otherwise)"),
                                @tr("Always use first page"),
                            ];
                            // Two-way (`<=>`) is required — see the sort
                            // ComboBox above for why a one-way binding breaks.
                            current-index <=> root.cover_mode;
                        }
                    }

                    RegenHint { text: @tr("To apply a change here to thumbnails that already exist, use Regenerate thumbnails."); }
                }
            }

            Tab {
                title: @tr("Display");
                TabPage {
                    GroupBox {
                        vertical-stretch: 0;
                        title: @tr("Identification overlay");
                        VerticalLayout {
                            spacing: 6px;
                            CheckBox {
                                vertical-stretch: 0;
                                text: @tr("Mark archives with a coloured border");
                                checked <=> root.overlay_border;
                            }
                            CheckBox {
                                vertical-stretch: 0;
                                text: @tr("Mark archives with a format label (CBZ, EPUB, ...)");
                                checked <=> root.overlay_label;
                            }
                            Text {
                                vertical-stretch: 0;
                                text: @tr("Show the overlay on these file types:");
                            }
                            // Same grid as the Files tab. Greyed out
                            // while both cues above are off, since the
                            // list only narrows them.
                            GridLayout {
                                spacing: 8px;
                                for entry[i] in root.overlay_extensions: CheckBox {
                                    row: Math.floor(i / 6);
                                    col: Math.mod(i, 6);
                                    vertical-stretch: 0;
                                    enabled: root.overlay_border || root.overlay_label;
                                    text: entry.name;
                                    checked: entry.enabled;
                                    toggled => {
                                        root.toggle_overlay_extension(i);
                                    }
                                }
                            }
                        }
                    }

                    RegenHint { text: @tr("To apply a change here to thumbnails that already exist, use Regenerate thumbnails."); }

                    GroupBox {
                        vertical-stretch: 0;
                        title: @tr("Preview pane");
                        CheckBox {
                            vertical-stretch: 0;
                            text: @tr("Enable preview pane (Alt+P)");
                            checked <=> root.enable_preview;
                        }
                    }

                    GroupBox {
                        vertical-stretch: 0;
                        title: @tr("Language");
                        VerticalLayout {
                            spacing: 6px;
                            ComboBox {
                                vertical-stretch: 0;
                                model: root.language_names;
                                // Two-way (`<=>`) is required — see the sort
                                // ComboBox for why a one-way binding breaks.
                                current-index <=> root.language_index;
                            }
                            RegenHint { text: @tr("A language change shows up the next time you open this window."); }
                        }
                    }
                }
            }
        }

        HorizontalBox {
            vertical-stretch: 0;
            spacing: 6px;
            Button {
                text: @tr("Regenerate thumbnails");
                clicked => { root.regenerate_clicked(); }
            }
            Rectangle { horizontal-stretch: 1; }
            Button {
                text: @tr("OK");
                primary: true;
                clicked => { root.ok_clicked(); }
            }
            Button {
                text: @tr("Cancel");
                clicked => { root.cancel_clicked(); }
            }
            Button {
                text: @tr("Apply");
                clicked => { root.apply_clicked(); }
            }
        }
    }
}

export component AboutDialog inherits Window {
    title: @tr("About ArcThumb");
    icon: @image-url("../assets/icon.png");
    preferred-width: 460px;
    preferred-height: 460px;

    // "ArcThumb 1.2.3", set from Rust. Not translated.
    in property <string> version_text;

    callback close_clicked();

    VerticalBox {
        padding: 18px;
        spacing: 14px;

        Text {
            text: root.version_text;
            font-size: 18px;
            font-weight: 700;
            horizontal-alignment: center;
        }

        Text {
            text: @tr("ArcThumb — archive thumbnail provider for Windows Explorer.\n\nThis application uses Slint (https://slint.dev) under the Slint Royalty-Free License 2.0.");
            wrap: word-wrap;
            horizontal-alignment: center;
        }

        AboutSlint { }

        Rectangle { vertical-stretch: 1; }

        HorizontalBox {
            Rectangle { horizontal-stretch: 1; }
            Button {
                text: @tr("Close");
                clicked => { root.close_clicked(); }
            }
            Rectangle { horizontal-stretch: 1; }
        }
    }
}

export component UpdateDialog inherits Window {
    title: @tr("Update available");
    icon: @image-url("../assets/icon.png");
    preferred-width: 440px;
    preferred-height: 220px;

    // Version numbers without the leading "v"; the message adds it.
    in property <string> latest_version;
    in property <string> current_version;

    in-out property <bool> skip_checked: false;

    callback open_clicked();
    callback later_clicked();

    VerticalBox {
        padding: 18px;
        spacing: 14px;

        Text {
            text: @tr("A new version of ArcThumb is available: v{}  (current: v{})", root.latest_version, root.current_version);
            wrap: word-wrap;
        }

        CheckBox {
            text: @tr("Skip this version");
            checked <=> root.skip_checked;
        }

        Rectangle { vertical-stretch: 1; }

        HorizontalBox {
            spacing: 6px;
            Rectangle { horizontal-stretch: 1; }
            Button {
                text: @tr("Open download page");
                primary: true;
                clicked => { root.open_clicked(); }
            }
            Button {
                text: @tr("Remind me later");
                clicked => { root.later_clicked(); }
            }
        }
    }
}

export component DonationDialog inherits Window {
    title: @tr("Thank you for updating!");
    icon: @image-url("../assets/icon.png");
    preferred-width: 440px;
    preferred-height: 220px;

    // Version number without the leading "v"; the message adds it.
    in property <string> version;

    in-out property <bool> dont_show_checked: false;

    callback support_clicked();
    callback later_clicked();

    VerticalBox {
        padding: 18px;
        spacing: 14px;

        Text {
            text: @tr("ArcThumb has been updated to v{}.\nWould you like to support development?", root.version);
            wrap: word-wrap;
        }

        CheckBox {
            text: @tr("Don't show this again");
            checked <=> root.dont_show_checked;
        }

        Rectangle { vertical-stretch: 1; }

        HorizontalBox {
            spacing: 6px;
            Rectangle { horizontal-stretch: 1; }
            Button {
                text: @tr("Open support page");
                primary: true;
                clicked => { root.support_clicked(); }
            }
            Button {
                text: @tr("Maybe next time");
                clicked => { root.later_clicked(); }
            }
        }
    }
}

// Preview-only wrapper. The production `MainWindow` receives its
// toggle lists and the language dropdown entries from Rust at
// startup; VS Code's Slint preview and `slint-viewer` have no Rust
// side, so they would render the grids and the dropdown empty. This
// component inherits `MainWindow` and assigns plausible defaults so
// the preview shows a realistic layout. Not used by the binary.
export component MainWindowPreview inherits MainWindow {
    language_names: ["Automatic (follow Windows)", "English", "日本語"];

    // Dummy toggle rows so the grids actually render. Lengths roughly
    // match the real `registry::EXTENSIONS` and `SUPPORTED_IMAGE_EXTS`
    // so the preview shows the same number of rows as production.
    extensions: [
        { name: ".zip",  enabled: true  },
        { name: ".cbz",  enabled: true  },
        { name: ".rar",  enabled: true  },
        { name: ".cbr",  enabled: false },
        { name: ".7z",   enabled: true  },
        { name: ".cb7",  enabled: false },
        { name: ".tar",  enabled: false },
        { name: ".epub", enabled: true  },
        { name: ".fb2",  enabled: false },
        { name: ".mobi", enabled: false },
        { name: ".azw",  enabled: false },
        { name: ".azw3", enabled: false },
    ];
    overlay_extensions: [
        { name: ".zip",  enabled: true  },
        { name: ".cbz",  enabled: true  },
        { name: ".rar",  enabled: true  },
        { name: ".cbr",  enabled: true  },
        { name: ".7z",   enabled: true  },
        { name: ".cb7",  enabled: true  },
        { name: ".cbt",  enabled: true  },
        { name: ".epub", enabled: true  },
        { name: ".fb2",  enabled: true  },
        { name: ".mobi", enabled: false },
        { name: ".azw",  enabled: false },
        { name: ".azw3", enabled: true  },
    ];
    image_extensions: [
        { name: ".jpg",  enabled: true  },
        { name: ".jpeg", enabled: true  },
        { name: ".png",  enabled: true  },
        { name: ".gif",  enabled: true  },
        { name: ".bmp",  enabled: true  },
        { name: ".tiff", enabled: true  },
        { name: ".tif",  enabled: true  },
        { name: ".webp", enabled: true  },
        { name: ".ico",  enabled: true  },
    ];
}
